# Used by docker-compose.prod.yml. SITE_ADDRESS comes from backend/.env via compose:
#   SITE_ADDRESS   the public hostname: automatic Let's Encrypt certificate + HTTP->HTTPS
#                  redirect. `localhost` uses Caddy's internal CA (for trying the stack locally).
# Django only ever sees SITE_ADDRESS, so its ALLOWED_HOSTS and CSRF origin stay a single name.
# Caddy sets X-Forwarded-Proto/-For itself, which BEHIND_PROXY relies on. Compression is left to
# Django's GZip middleware.
{$SITE_ADDRESS} {
	reverse_proxy web:8000
}
