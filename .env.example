# Docker Compose variable substitution (read from the repo-root .env, gitignored).
# Not needed for a normal single checkout — the defaults below apply. `task wt:new`
# writes this file in each worktree with free ports so several stacks can run at once.

# Host port published for Postgres/PostGIS (container port stays 5432).
DB_PORT=5432
# Host port published for the Django dev server (container port stays 8000).
WEB_PORT=8000

# These variables are for the dev stack (docker-compose.yml). The production stack
# (docker-compose.prod.yml) reads its variables from backend/.env instead, passed with
# `--env-file backend/.env`; they're documented in backend/.env.example.
