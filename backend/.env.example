DEBUG=True
SECRET_KEY=change-me-in-real-envs
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: a real secret (the app refuses to start with this default when DEBUG is off),
# DEBUG=False, ALLOWED_HOSTS=<your hostname>.
# Full origins (with scheme), comma-separated; needed for admin login over HTTPS.
# CSRF_TRUSTED_ORIGINS=https://solar-map.example.com
# Set True when a reverse proxy terminates TLS (trust X-Forwarded-Proto, secure cookies).
# BEHIND_PROXY=False

DATABASE_NAME=solar_map
DATABASE_USER=solar_map
DATABASE_PASSWORD=solar_map
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Production stack (docker-compose.prod.yml) ---------------------------------------
# Run with: docker compose --env-file backend/.env -f docker-compose.prod.yml up -d --build
# The prod file sets DEBUG, BEHIND_PROXY, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS and
# DATABASE_HOST itself (derived from SITE_ADDRESS), so only the values below belong in the
# server's backend/.env. SECRET_KEY and DATABASE_PASSWORD must be real secrets there.
# Hostname Caddy serves and gets a Let's Encrypt certificate for. `localhost` makes Caddy use
# its internal CA instead, for trying the stack locally.
# SITE_ADDRESS=solar-map.tomharrisonjr.com
# Optional: a second hostname that only 301-redirects to SITE_ADDRESS (it also gets a
# certificate), e.g. the environment-specific name when SITE_ADDRESS is a friendlier alias.
# Leave unset when there's no alias. `terraform output` prints both values per environment.
# REDIRECT_FROM=solar-map-prod.tomharrisonjr.com
# gunicorn worker processes (default 3, sized for a 2 GB instance).
# WEB_CONCURRENCY=3
# Host ports Caddy publishes (default 80 and 443); change only to run beside another stack.
# HTTP_PORT=80
# HTTPS_PORT=443
# --- Basemap tiles ---------------------------------------------------------------------
# Defaults to Stadia Maps' Alidade Smooth raster tiles, which need no key: Stadia identifies
# the site by the Origin/Referer of each tile request. localhost works as is (rate-limited);
# for a deployed hostname, add the domain in the Stadia dashboard. Free tier: 200k credits per
# month, non-commercial use only.
# To use another provider, set these (attribution is HTML and is always shown on the map):
# BASEMAP_TILES_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png
# BASEMAP_ATTRIBUTION=&copy; <a href="https://example.com">Example</a>
# BASEMAP_MAX_ZOOM=20
# Only if the provider wants a key (sent as ?api_key=...). It is visible in the page, so
# restrict it by referrer/domain in the provider's dashboard.
# BASEMAP_API_KEY=
