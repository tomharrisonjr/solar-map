# Machine/person-specific values, applied to every environment. Per-environment values (hostname)
# are committed in envs/<env>.tfvars. Provide these either way (same names):
#   - copy this file to infra/terraform.tfvars (gitignored) and fill it in, or
#   - with direnv, copy .envrc.example to .envrc (gitignored) and `direnv allow`; it sets them as
#     TF_VAR_<name> environment variables, and can look up your current IP for you.
# Terraform reads terraform.tfvars and TF_VAR_* alike; -var-file values win over TF_VAR_*.

# Required: who may SSH in (port 22). Your current public IP plus /32; must not be 0.0.0.0/0.
#   curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.7/32"

# Required for AWS access unless your default credential chain already works: a named profile
# from `aws configure list-profiles`. Needs Lightsail and Route 53 permissions.
aws_profile = "your-aws-profile"

# Optional (defaults shown). The public key is installed for the `ubuntu` user: connect with the
# `ssh_command` output (the matching private key must be in your ssh-agent or ~/.ssh).
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# aws_region          = "us-east-2"
# bundle_id           = "small_3_0"
# repo_url            = "https://github.com/tomharrisonjr/solar-map.git"
# domain              = "tomharrisonjr.com"  # an existing Route 53 hosted zone you control
