# direnv equivalent of terraform.tfvars (see terraform.tfvars.example). Copy to .envrc, edit,
# then `direnv allow`. .envrc is gitignored: it is per machine.
export AWS_PROFILE=your-aws-profile
export ENV=dev  # default environment for `task tf:*` (dev|staging|prod)

export TF_VAR_aws_profile="$AWS_PROFILE"
export TF_VAR_aws_region="us-east-2"
